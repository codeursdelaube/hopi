# Copier ce fichier en .env.local puis remplir les valeurs (ne jamais commiter .env.local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) — serveur uniquement, ne jamais exposer côté client.
SUPABASE_SECRET_KEY=
# Connexion Postgres directe (pour appliquer les migrations avec la CLI Supabase).
DIRECT_URL=
# Optionnel : URL publique du site (SEO). Par défaut https://hopigame.vercel.app
NEXT_PUBLIC_SITE_URL=
# Notifications push : générer avec `npm run setup:push` (ajoute les valeurs à .env.local).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secret de la tâche planifiée Vercel Cron (/api/cron/notifications).
CRON_SECRET=
